{% import "macros.html.j2" as m with context %}
{% set name = 'Network' if p.is_b else 'Findings' %}
<!doctype html>
<html lang="en" class="no-js">
<head>
<title>Claims · {{ name }} · Q1 tree planting</title>
<meta name="description" content="Every claim behind the {{ name }} panel of Q1, with its source sentence, paper, year and DOI.">
{% include "head.html.j2" %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-head">
<div class="topbar"><div class="wrap">
<p class="eyebrow"><a href="index.html#{{ p.key }}">← Q1 · Tree planting: {{ name }} panel</a></p>
{{ m.theme_btn() }}
</div></div>
<div class="wrap">
<h1>Claims behind the {{ name }} panel</h1>
<p class="question">All {{ p.stats.n_claims }} claims of <code>answers/{{ 'q1_tree_planting_graph.json' if p.is_b else 'q1_tree_planting.json' }}</code> with their source sentences, grouped by {{ 'edge' if p.is_b else 'finding' }}, papers with the most claims first.</p>
</div>
</header>
<main id="main" class="wrap">
<div class="tbl claims-page">
<div class="tscroll">
<table class="t-claims">
<caption>All {{ p.stats.n_claims }} claims with their source sentences</caption>
<thead><tr><th scope="col">Claim</th><th scope="col">Direction</th><th scope="col">Grade</th><th scope="col">Quote</th><th scope="col">Paper</th></tr></thead>
{% for g in p.claim_groups %}
<tbody id="{{ g.id }}">
<tr class="grp"><th colspan="5" scope="rowgroup">{% if g.key %}<a href="index.html#{{ p.item_by[g.key].anchor }}">{{ g.title }}</a>{% else %}{{ g.title }}{% endif %} · {{ plural(g.cids|length, 'claim', 'claims') }}</th></tr>
{% for cid in g.cids %}{{ m.claim_row(p.pre, cid, p.ev[cid]) }}{% endfor %}
</tbody>
{% endfor %}
</table>
</div>
</div>
</main>
<footer class="site-foot">
<div class="wrap">
<p>Built from the Evidence Jam 2026 Lane 3 pack. Claims, quotes, titles, years and DOIs are shown as the file gives them.</p>
</div>
</footer>
</body>
</html>
