{# Direction and certainty: the word is text; the glyph and the dots come
   from CSS (class d-<direction>, c<1-4>) with empty alt text. #}
{% macro dir(key, word) %}<span class="dw d-{{ key }}">{{ word }}</span>{% endmacro %}

{% macro cert(n, word) %}<span class="cw c{{ n }}">{{ word }}</span>{% endmacro %}

{% macro sd(list) %}{% for s in list %}<span class="s d-{{ s.key }}"><i>{{ s.word }}</i> {{ s.n }}</span>{% endfor %}{% endmacro %}

{% macro doiLink(doi, doc) %}{% if doi %}<a href="{{ doi | doiUrl }}">doi:{{ doi }}</a>{% else %}<span class="mono">{{ doc }}</span> (no DOI){% endif %}{% endmacro %}

{% macro yearOf(y) %}{% if y %}{{ y }}{% else %}no year{% endif %}{% endmacro %}

{% macro so(c) %}{{ c.subject }} <i>{% if c.negated %}not {% endif %}{{ c.predicateText }}</i> {{ c.object }}{% endmacro %}

{% macro chip(r, p, k) %}<g class="chip d-{{ r.direction }}" tabindex="0" role="button" data-pin="{{ r.pin }}" aria-label="{{ r.aria }}" transform="translate({{ p.x }} {{ p.y }})"><rect x="-30" y="-11" width="60" height="22" rx="11"/><text x="-18" y="5">{{ r.dir.glyph }}</text><use href="#{{ k }}-d{{ r.cert.n }}" x="-5"/></g>{% endmacro %}

{# ---------------------------------------------------------------- graph #}
{% macro graph(P) %}
{% set G = P.graph %}
{% set k = P.key %}
<svg class="g" id="{{ k }}-svg" viewBox="0 0 {{ G.width }} {{ G.height }}" width="{{ G.width }}" height="{{ G.height }}" role="group" aria-label="{{ P.name }} graph: {{ G.nodes.length }} nodes, {{ G.edges.length + G.moderations.length }} {{ P.itemWord[1] }}, {{ G.gaps.length }} gap{{ 's' if G.gaps.length != 1 }}. Each chip is a button.">
<defs>
{% for n in [1, 2, 3, 4] %}
<g id="{{ k }}-d{{ n }}" class="dd">{% for i in [0, 1, 2, 3] %}<circle cx="{{ i * 8 }}" r="3"{% if i < n %} class="f"{% endif %}/>{% endfor %}</g>
{% endfor %}
</defs>
<g class="hd" aria-hidden="true">
{% for h in G.headers %}
<text class="lt" x="{{ h.title.x }}" y="{{ h.title.y }}">{{ h.title.text }}</text>
{% for s in h.sub %}<text class="ls" x="{{ s.x }}" y="{{ s.y }}">{{ s.text }}</text>{% endfor %}
{% endfor %}
</g>
<g class="lines">
{% for m in G.memberships %}
<path class="mb" d="{{ m.d }}" data-s="{{ m.s }}" data-t="{{ m.t }}"/>
{% endfor %}
{% for x in G.gaps %}
<g class="gp" data-pin="g:{{ x.id }}" data-s="{{ x.s }}" data-t="{{ x.t }}"><path class="go" d="{{ x.d }}"/><path class="gi" d="{{ x.d }}"/></g>
{% endfor %}
{% for e in G.edges %}
<g class="e d-{{ e.row.direction }}" data-pin="{{ e.row.pin }}" data-s="{{ e.s }}" data-t="{{ e.t }}" data-lens="{{ e.row.lens }}"><path d="{{ e.d }}" stroke-width="{{ e.sw }}"/><polygon points="{{ e.arrow }}"/></g>
{% endfor %}
{% for m in G.moderations %}
<g class="e md d-{{ m.row.direction }}" data-pin="{{ m.row.pin }}" data-s="{{ m.s }}" data-te="{{ m.te }}" data-lens="{{ m.row.lens }}"><path d="{{ m.d }}" stroke-width="{{ m.sw }}"/></g>
{% endfor %}
</g>
<g class="nodes">
{% for n in G.nodes %}
<g class="node k-{{ n.kind if n.kind else ('factor' if n.lane == 0 else 'outcome') }}" tabindex="0" role="button"{% if k == "b" %} data-node-id="{{ n.id }}"{% endif %} data-pin="{{ n.pin }}" data-label="{{ n.label }}" data-kind="{{ n.kindLine }}"{% if n.members.length %} data-members="{{ n.members | join(' ', 'id') }}"{% endif %} aria-label="{{ n.aria }}">
<rect x="{{ n.x }}" y="{{ n.y }}" width="{{ n.w }}" height="{{ n.h }}" rx="{{ n.h / 2 if n.kind == 'condition' else (3 if n.kind == 'site_treatment' else 10) }}"/>
{% if n.kind == "outcome" or (not n.kind and n.lane == 1) %}<rect class="ni" x="{{ n.x + 4 }}" y="{{ n.y + 4 }}" width="{{ n.w - 8 }}" height="{{ n.h - 8 }}" rx="7"/>{% endif %}
{% if n.kind == "planting_stock" %}<rect class="sb" x="{{ n.x + 5 }}" y="{{ n.y + 9 }}" width="3" height="{{ n.h - 18 }}" rx="1.5"/>{% endif %}
{% for l in n.lines %}<text x="{{ l.x }}" y="{{ l.y }}">{{ l.text }}</text>{% endfor %}
{% for c in n.chips %}<rect class="mc" x="{{ c.x }}" y="{{ c.y }}" width="{{ c.w }}" height="{{ c.h }}" rx="10"/><text class="mt" x="{{ c.tx }}" y="{{ c.ty }}">{{ n.members[loop.index0].label }}</text>{% endfor %}
</g>
{% endfor %}
</g>
<g class="chips">
{% for e in G.edges %}{{ chip(e.row, e.chip, k) }}{% endfor %}
{% for x in G.moderations %}{{ chip(x.row, x.chip, k) }}{% endfor %}
{% for x in G.gaps %}
<g class="chip gl" tabindex="0" role="button" data-pin="g:{{ x.id }}" aria-label="Gap, no evidence: {{ x.gap.src.label }} to {{ x.gap.tgt.label }}. No study in this corpus tested this pairing. This is a gap, not a negative result." transform="translate({{ x.label.x }} {{ x.label.y }})"><rect x="-46" y="-10" width="92" height="20" rx="5"/><text y="4">No evidence</text></g>
{% endfor %}
{% for x in G.moderations %}
<polygon class="dia d-{{ x.row.direction }}" data-pin="{{ x.row.pin }}" points="{{ x.diamond }}"/>
{% endfor %}
</g>
</svg>
{% endmacro %}
