{% import "macros.html.j2" as m with context %}
{% set X = p.matrix %}
<div class="mx-scroll">
<table class="matrix">
<caption>Rows are sources, columns are targets. One cell per {{ 'edge' if p.is_b else 'finding' }}. A hatched cell is a listed gap. A blank cell means no claims in this corpus link the two.</caption>
<thead><tr><td class="mx-corner"></td>{% for c in X.cols %}<th scope="col">{{ c.label }}</th>{% endfor %}</tr></thead>
<tbody>
{% for r in X.rows %}
<tr><th scope="row">{{ r.label }}</th>
{% for c in X.cols %}
{% set cell = X.cells.get((r.id, c.id)) %}
{% if not cell %}<td class="mx-empty" title="No claims in this corpus link these two"></td>
{% elif cell[0] == 'g' %}<td class="mx-gap"><button type="button" data-k="{{ cell[1].key }}" aria-label="{{ cell[1].aria }}">No evidence</button></td>
{% else %}{% set it = cell[1] %}<td class="mx-e"><button type="button" class="d-{{ it.direction }}" data-k="{{ it.key }}" aria-label="{{ it.aria }}"><span class="g" aria-hidden="true">{{ DIR_GLYPH[it.direction] }}</span>{{ m.dots(it.certainty) }}</button></td>
{% endif %}
{% endfor %}
</tr>
{% endfor %}
</tbody>
</table>
</div>
{% if p.mods %}
<ul class="mx-mods">
{% for it in p.mods %}<li><span class="lbl">Moderation (an edge onto an edge, not a cell):</span> <button type="button" class="mini" data-k="{{ it.key }}" aria-label="{{ it.aria }}"><span aria-hidden="true">◆</span> {{ it.src_label }} → effect of {{ it.tgt_label }} {{ m.glyph(it.direction) }}{{ m.dots(it.certainty) }}</button></li>{% endfor %}
</ul>
{% endif %}
