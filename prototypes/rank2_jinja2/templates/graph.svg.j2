{% import "macros.html.j2" as m with context %}
{% set G = p.geo %}
{% set pre = p.pre %}
<svg class="graph" id="{{ pre }}-svg" viewBox="0 0 {{ G.width|n }} {{ G.height|n }}" width="{{ G.width|n }}" height="{{ G.height|n }}" style="--w:{{ G.width|n }}px" role="group" aria-label="{{ 'Network graph' if p.is_b else 'Findings graph' }}: {{ p.nodes|length }} nodes, {{ plural(p.its|length, 'edge', 'edges') }}, {{ plural(p.gaps|length, 'gap', 'gaps') }}. Each node and edge chip is a button.">
<defs>
{% for d in DIR_ORDER %}
<marker id="{{ pre }}-ar-{{ d }}" class="mk d-{{ d }}" viewBox="0 0 11 11" refX="0" refY="5.5" markerWidth="11" markerHeight="11" markerUnits="userSpaceOnUse" orient="auto"><path d="M0 0L11 5.5L0 11z"/></marker>
{% endfor %}
{% for it in p.mods %}
<marker id="{{ pre }}-dm-{{ it.direction }}" class="mk d-{{ it.direction }}" viewBox="0 0 12 12" refX="6" refY="6" markerWidth="13" markerHeight="13" markerUnits="userSpaceOnUse" orient="auto"><path d="M6 0L12 6L6 12L0 6z"/></marker>
{% endfor %}
{% for k in range(1, 5) %}
<g id="{{ pre }}-dots{{ k }}">{% for i in range(4) %}{% if i < k %}<circle cx="{{ i * 8 }}" cy="0" r="3" fill="currentColor"/>{% else %}<circle cx="{{ i * 8 }}" cy="0" r="2.4" fill="none" stroke="currentColor" stroke-width="1.2"/>{% endif %}{% endfor %}</g>
{% endfor %}
</defs>
<g class="lanes" aria-hidden="true">
{% for t in G.lane_titles + G.group_heads %}
{% set ty = t.y if t.y is defined else 0 %}
<text class="lt" x="{{ t.x|n }}" y="{{ (ty + 14)|n }}">{{ t.title }}</text>
{% for l in t.sub %}<text class="ls" x="{{ t.x|n }}" y="{{ (ty + 30 + loop.index0 * SUB_LH)|n }}">{{ l }}</text>{% endfor %}
{% endfor %}
</g>
<g class="l-mem">
{% for mp in G.mem_paths %}<path class="mem" d="{{ mp.d }}" data-mem="{{ mp.member }} {{ mp.combo }}"/>{% endfor %}
</g>
<g class="l-gap">
{% for g in p.gaps %}
<g class="edge gap" data-k="{{ g.key }}"><path class="hit" d="{{ g.d }}"/><path class="gp1" d="{{ g.d }}"/><path class="gp2" d="{{ g.d }}"/></g>
{% endfor %}
</g>
<g class="l-edge">
{% for it in p.its|rejectattr('kind', 'equalto', 'moderation')|sort(attribute='width', reverse=True) %}
<g class="edge d-{{ it.direction }}" data-k="{{ it.key }}"><path class="hit" d="{{ it.d }}"/><path class="ln" d="{{ it.d }}" stroke-width="{{ it.width|n }}" marker-end="url(#{{ pre }}-ar-{{ it.direction }})"/></g>
{% endfor %}
{% for it in p.mods %}
<g class="edge mod d-{{ it.direction }}" data-k="{{ it.key }}"><path class="hit" d="{{ it.d }}"/><path class="ln" d="{{ it.d }}" stroke-width="{{ it.width|n }}" marker-end="url(#{{ pre }}-dm-{{ it.direction }})"/></g>
{% endfor %}
</g>
<g class="l-node">
{% for n in p.nodes %}{{ m.svg_node(n, p) }}{% endfor %}
</g>
<g class="l-chip">
{% for it in p.its %}{{ m.svg_chip(it, p) }}{% endfor %}
{% for g in p.gaps %}
<g class="gapl" transform="translate({{ g.chip[0]|n }} {{ g.chip[1]|n }})" tabindex="0" role="button" data-k="{{ g.key }}" data-gap-id="{{ g.id }}" aria-label="{{ g.aria }}">
<rect x="{{ (-GAPL_W / 2)|n }}" y="{{ (-GAPL_H / 2)|n }}" width="{{ GAPL_W }}" height="{{ GAPL_H }}" rx="4"/>
<text x="0" y="4" text-anchor="middle">No evidence</text>
</g>
{% endfor %}
</g>
</svg>
