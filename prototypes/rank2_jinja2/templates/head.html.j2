<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
{# Runs before the first paint: marks JS as on and applies a stored theme, so there is no flash. #}
<script>(function(d){d.className="js";try{var t=localStorage.getItem("q1-theme");if(t==="light"||t==="dark")d.setAttribute("data-theme",t)}catch(e){}})(document.documentElement)</script>
<link rel="stylesheet" href="assets/site.css">
<script src="assets/site.js" defer></script>
